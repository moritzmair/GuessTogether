# Server-Key: ruft die Street View Metadata API auf.
# Bleibt im Backend -> in der Cloud Console am besten auf die Server-IP einschraenken.
# Benoetigte API: "Street View Static API"
GOOGLE_MAPS_API_KEY=dein_key_hier

# Browser-Key: wird an das Frontend ausgeliefert und laedt die Maps JavaScript API.
# Im Browser zwangslaeufig oeffentlich -> per HTTP-Referrer auf die eigene Domain
# und per API-Restriktion auf die "Maps JavaScript API" begrenzen.
# Optional: ohne diesen Eintrag nutzt der Client den Server-Key oben.
GOOGLE_MAPS_BROWSER_KEY=
